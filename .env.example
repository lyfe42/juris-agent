# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不要提交。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 生成与判分刻意用不同模型，规避 LLM-as-Judge 的自我偏好偏差。
#
# ⚠️ 这两个名字是**实测出来的**，别照抄旧教程：`GET https://api.deepseek.com/models`
# 目前只返回 `deepseek-flash`(V4.1-Flash) 和 `deepseek-v4-pro` 两个 id。
# 老文档里常见的 `deepseek-chat` / `deepseek-reasoner` 在当前账号上不存在，会直接 400。
# 换 key 或过一段时间后，先跑 `python scripts/check_api.py` 核对可用模型。
JURIS_AGENT_MODEL_GEN=deepseek-flash
JURIS_AGENT_MODEL_JUDGE=deepseek-v4-pro

# HuggingFace 镜像。必须在 import transformers 之前生效（src/juris_agent/__init__.py 已处理）
HF_ENDPOINT=https://hf-mirror.com

# LLM 调用模式：
#   off    = 不读缓存、不写缓存，每次都真调模型
#   record = 先读缓存，未命中就调模型并写缓存
#   replay = 只读缓存，未命中直接抛 ReplayMiss
#
# **跑消融矩阵时用 record**——否则同样入参两次跑出不同结果，各臂之间就不可比了。
# CI / 离线复现用 replay（零成本、零网络）。
#
# ⚠️ **但不要用 record/replay 去测延迟。** 缓存命中时一次 LLM 调用的耗时
# 从 6.7 秒塌到 40 毫秒（实测，差 160 倍），而指标一模一样。
# 要报走 LLM 的臂的真实延迟，必须切成 off 单独跑一次。
# scripts/ablation.py 会读这个变量，并对走 LLM 的臂在表里打 ⚠️ 标记。
JURIS_AGENT_LLM_MODE=off
