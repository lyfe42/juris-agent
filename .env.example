# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不要提交。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 生成与判分刻意用不同模型，规避 LLM-as-Judge 的自我偏好偏差
LEXGUARD_MODEL_GEN=deepseek-chat
LEXGUARD_MODEL_JUDGE=deepseek-reasoner

# HuggingFace 镜像。必须在 import transformers 之前生效（config.py 顶部已处理）
HF_ENDPOINT=https://hf-mirror.com
